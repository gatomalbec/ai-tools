#!/usr/bin/env bash
set -euo pipefail

# Resolve this script's real path so symlink installs (e.g. ~/.local/bin/safe-pi)
# still find the repo-local safe-pi-vm.sh.
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  TARGET="$(readlink "$SOURCE")"
  if [[ "$TARGET" != /* ]]; then
    SOURCE="$DIR/$TARGET"
  else
    SOURCE="$TARGET"
  fi
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
VM_WRAPPER="$SCRIPT_DIR/safe-pi-vm.sh"

if [[ ! -x "$VM_WRAPPER" ]]; then
  echo "safe-pi error: missing executable VM wrapper at $VM_WRAPPER" >&2
  exit 1
fi

# Host wrapper command: safe-pi
# VM command executed: pi
#
# Wrapper-only convenience flags:
#   --resume   Do not auto-prepend --new-session for this invocation.
resume=0
forwarded_args=()

for arg in "$@"; do
  case "$arg" in
    --resume)
      resume=1
      ;;
    *)
      forwarded_args+=("$arg")
      ;;
  esac
done

if [[ "$resume" -eq 1 ]]; then
  exec env SAFE_PI_NEW_SESSION=false "$VM_WRAPPER" run "${forwarded_args[@]}"
fi

exec "$VM_WRAPPER" run "${forwarded_args[@]}"
